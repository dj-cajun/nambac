# ═══════════════════════════════════════════════════════════
# nambac 환경 변수 — .env.local 에 복사해서 사용
# Vercel: Settings → Environment Variables → Production → Redeploy
# ═══════════════════════════════════════════════════════════

# ── ① 홈 퀴즈 목록 / 퀴즈 플레이 (필수) ──
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your_turso_token
VITE_API_URL=/api

# ── ② AI 퀴즈 전체 생성 (텍스트 + 이미지 9장 + DB 저장) ──
# 텍스트 (브라우저 — VITE_ 필수)
VITE_GEMINI_API_KEY=your_gemini_key
# 이미지 (서버 — VITE_ 붙이면 안 됨)
OPENROUTER_API_KEY=your_openrouter_key
OPENROUTER_IMAGE_MODEL=black-forest-labs/flux.2-klein-4b
# Admin 인증 (서버+브라우저 — 같은 값)
ADMIN_API_KEY=your_admin_secret
VITE_ADMIN_API_KEY=your_admin_secret

# ── ③ AdSense (기본 OFF — docs/ADSENSE_SETUP.md) ──
# VITE_ADSENSE_ENABLED=true
# VITE_ADSENSE_PUB_ID=ca-pub-xxxx
# VITE_ADSENSE_SLOT_HOME=
# VITE_ADSENSE_SLOT_QUIZ=
# VITE_ADSENSE_SLOT_RESULT_1=
# VITE_ADSENSE_SLOT_RESULT_2=

# ── ④ 기타 선택 ──
VITE_SITE_URL=https://nambac.vercel.app
CRON_SECRET=your_cron_secret
N8N_WEBHOOK_SECRET=your_n8n_secret
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:nam@nambac.xyz
VITE_PREMIUM_CODE=nambac-vip
