# Turso (required)
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your_turso_database_token
VITE_API_URL=/api

# OpenRouter (image generation — server-side only)
OPENROUTER_API_KEY=your_openrouter_key
OPENROUTER_IMAGE_MODEL=black-forest-labs/flux.2-klein-4b

# Gemini (quiz text generation — frontend)
VITE_GEMINI_API_KEY=your_gemini_key

# Admin API key
ADMIN_API_KEY=your_admin_key
VITE_ADMIN_API_KEY=your_admin_key

# Google AdSense (optional — leave blank to hide ad slots in dev)
VITE_ADSENSE_PUB_ID=ca-pub-7386903584540643
VITE_ADSENSE_SLOT_HOME=
VITE_ADSENSE_SLOT_QUIZ=
VITE_ADSENSE_SLOT_RESULT_1=
VITE_ADSENSE_SLOT_RESULT_2=

# Analytics (GTM container ID is in index.html — GTM-P56XG75Q)
# Configure GA4 events in GTM: quiz_start, quiz_complete, share_zalo, compat_start
