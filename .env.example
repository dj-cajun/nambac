# ═══════════════════════════════════════════════════════════
# nambac 환경 변수 — .env.local 에 복사해서 사용
# Vercel: Settings → Environment Variables → Production → Redeploy
# ═══════════════════════════════════════════════════════════

# ── ① 홈 퀴즈 목록 / 퀴즈 플레이 (필수) ──
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your_turso_token
VITE_API_URL=/api

# ── ② AI 퀴즈 전체 생성 (텍스트 + 이미지 9장 + DB 저장) ──
# 텍스트 (서버 전용 — VITE_ 붙이면 안 됨, 2개 권장)
GEMINI_API_KEY=your_gemini_key_account_1
GEMINI_API_KEY_2=your_gemini_key_account_2
# 또는 콤마 구분: GEMINI_API_KEYS=key1,key2
# 로컬 스크립트만: VITE_GEMINI_API_KEY=your_gemini_key
# 이미지: gemini-then-openrouter (기본) | gemini | openrouter
IMAGE_PROVIDER=gemini-then-openrouter
# 이미지 Flux fallback (서버)
OPENROUTER_API_KEY=your_openrouter_key
OPENROUTER_IMAGE_MODEL=black-forest-labs/flux.2-klein-4b
# Quiz intro/cover only — Gemini Image avoids Flux painting titles as text (default)
OPENROUTER_COVER_IMAGE_MODEL=google/gemini-2.5-flash-image
# COVER_IMAGE_PROVIDER=gemini-openrouter | flux
# Gemini 실패 시에만 OpenRouter 텍스트 fallback (퀴즈 JSON · 이미지 프롬프트)
#   deepseek/deepseek-v4-pro  $0.44 / $0.87  per 1M  ← 기본 (DeepSeek 최상위)
#   z-ai/glm-5.2              $0.73 / $2.29  per 1M  ← Z.ai 최상위
#   deepseek/deepseek-v4-flash $0.09 / $0.18  per 1M  ← 저렴
#   qwen/qwen3.5-flash        $0.07 / $0.26  per 1M  ← 최저가
OPENROUTER_TEXT_MODEL=deepseek/deepseek-v4-pro
# Admin 인증 (서버 필수 — Vercel Production)
ADMIN_API_KEY=your_admin_secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_admin_password
# Google OAuth (서버 전용)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
# 프로덕션: https://nambac.xyz/api/auth/google/callback (www 없이 — apex가 www로 넘김)
GOOGLE_REDIRECT_URI=
# 세션 쿠키 서명 (프로덕션 필수)
SESSION_SECRET=your_session_secret
# Google 로그인 시 자동 admin 권한 부여 (콤마 구분 이메일)
ADMIN_ALLOWED_EMAILS=you@gmail.com
# 로컬 dev 편의용 (선택, 프로덕션 번들에 넣지 말 것)
# VITE_ADMIN_API_KEY=your_admin_secret

# ── ③ AdSense (기본 OFF — docs/ADSENSE_SETUP.md) ──
# VITE_ADSENSE_ENABLED=true
# VITE_ADSENSE_PUB_ID=ca-pub-xxxx
# VITE_ADSENSE_SLOT_HOME=
# VITE_ADSENSE_SLOT_QUIZ=
# VITE_ADSENSE_SLOT_RESULT_1=
# VITE_ADSENSE_SLOT_RESULT_2=

# ── ④ 기타 선택 ──
# 도메인 연결 후: https://nambac.xyz (그 전까지 vercel.app)
VITE_SITE_URL=https://nambac.vercel.app
CRON_SECRET=your_cron_secret
N8N_WEBHOOK_SECRET=your_n8n_secret
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:nam@nambac.xyz
VITE_PREMIUM_CODE=
