{
  "functions": {
    "api/handler.js": {
      "maxDuration": 300,
      "memory": 1024,
      "includeFiles": "{api/_lib/fonts/**,node_modules/@resvg/resvg-wasm/index_bg.wasm}",
      "excludeFiles": "{public/images/**,legacy/**,scripts/**,backend/**,data/**,src/**,dist/**,docs/**,node_modules/@img/sharp-*darwin*,node_modules/@img/sharp-*win32*,node_modules/@img/sharp-libvips-*darwin*,node_modules/@img/sharp-libvips-*win32*}"
    }
  },
  "crons": [
    {
      "path": "/api/cron/daily-quiz",
      "schedule": "0 3 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/share/:id/:score",
      "destination": "/api/handler?path=og&id=:id&score=:score"
    },
    {
      "source": "/share/:id",
      "destination": "/api/handler?path=og&id=:id"
    },
    {
      "source": "/api/((?!handler$).*)",
      "destination": "/api/handler?path=$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
