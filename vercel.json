{
  "crons": [
    {
      "path": "/api/handler?route=cron/daily-quiz",
      "schedule": "0 3 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/share/:id/:score",
      "destination": "/api/handler?route=og&id=:id&score=:score"
    },
    {
      "source": "/share/:id",
      "destination": "/api/handler?route=og&id=:id"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/handler?route=:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
