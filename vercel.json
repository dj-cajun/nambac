{
  "crons": [
    {
      "path": "/api/cron/daily-quiz",
      "schedule": "0 3 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/share/:id/:score",
      "destination": "/api/og"
    },
    {
      "source": "/share/:id",
      "destination": "/api/og"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
