{
  "functions": {
    "api/handler.js": {
      "maxDuration": 300,
      "memory": 1024,
      "includeFiles": "{api/_lib/fonts/**,node_modules/@resvg/resvg-wasm/index_bg.wasm}",
      "excludeFiles": "{public/images/**,node_modules/@img/*darwin*,node_modules/@img/*win32*}"
    }
  },
  "crons": [
    {
      "path": "/api/cron/daily-quiz",
      "schedule": "0 3 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/share-fortune/:name/:idx/:date",
      "destination": "/api/handler?path=fortune-share&name=:name&idx=:idx&date=:date"
    },
    {
      "source": "/share-fortune/:name/:idx",
      "destination": "/api/handler?path=fortune-share&name=:name&idx=:idx"
    },
    {
      "source": "/share/:id/:score",
      "destination": "/api/handler?path=og&id=:id&score=:score"
    },
    {
      "source": "/share/:id",
      "destination": "/api/handler?path=og&id=:id"
    },
    {
      "source": "/api/((?!handler$).*)",
      "destination": "/api/handler?path=$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
