{
  "functions": {
    "api/handler.js": {
      "maxDuration": 300,
      "memory": 1024,
      "includeFiles": "{api/_lib/fonts/**,node_modules/@resvg/resvg-wasm/index_bg.wasm}",
      "excludeFiles": "{public/images/**,node_modules/@img/*darwin*,node_modules/@img/*win32*}"
    }
  },
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/api/quizzes",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=60, stale-while-revalidate=300"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, s-maxage=60, stale-while-revalidate=300"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "public, s-maxage=60, stale-while-revalidate=300"
        }
      ]
    },
    {
      "source": "/api/handler",
      "has": [{ "type": "query", "key": "path", "value": "quizzes" }],
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=60, stale-while-revalidate=300"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, s-maxage=60, stale-while-revalidate=300"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "public, s-maxage=60, stale-while-revalidate=300"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/share-fortune/:name/:idx/:date",
      "destination": "/api/handler?path=fortune-share&name=:name&idx=:idx&date=:date"
    },
    {
      "source": "/share-fortune/:name/:idx",
      "destination": "/api/handler?path=fortune-share&name=:name&idx=:idx"
    },
    {
      "source": "/share-balance/:id/:voted",
      "destination": "/api/handler?path=balance-share&q=:id&voted=:voted"
    },
    {
      "source": "/share-balance/:id",
      "destination": "/api/handler?path=balance-share&q=:id"
    },
    {
      "source": "/share-roast/:name/:trait",
      "destination": "/api/handler?path=roast-share&name=:name&trait=:trait"
    },
    {
      "source": "/share-brain/:name/:result",
      "destination": "/api/handler?path=brain-share&name=:name&result=:result"
    },
    {
      "source": "/share-lienquan/tuong/:hero",
      "destination": "/api/handler?path=lienquan-share&hero=:hero"
    },
    {
      "source": "/share-lienquan/:page",
      "destination": "/api/handler?path=lienquan-share&page=:page"
    },
    {
      "source": "/share-lienquan",
      "destination": "/api/handler?path=lienquan-share"
    },
    {
      "source": "/share-vbti/result/:code",
      "destination": "/api/handler?path=vbti-share&result=:code"
    },
    {
      "source": "/share-vbti/type/:code",
      "destination": "/api/handler?path=vbti-share&type=:code"
    },
    {
      "source": "/share-vbti/:page",
      "destination": "/api/handler?path=vbti-share&page=:page"
    },
    {
      "source": "/share-vbti",
      "destination": "/api/handler?path=vbti-share"
    },
    {
      "source": "/share/:id/:score",
      "destination": "/api/handler?path=og&id=:id&score=:score"
    },
    {
      "source": "/share/:id",
      "destination": "/api/handler?path=og&id=:id"
    },
    {
      "source": "/api/((?!handler$).*)",
      "destination": "/api/handler?path=$1"
    },
    {
      "source": "/((?!api/|sitemap\\.xml|robots\\.txt|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
